generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  metaTitle      String?
  metaDescription String?
  ogImage        String?
  variants       PageVariant[]
  pageViews      PageView[]
  events         Event[]
  formSubmissions FormSubmission[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PageVariant {
  id          String     @id @default(cuid())
  pageId      String
  page        Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name        String
  content     Json       @default("{}")
  isControl   Boolean    @default(false)
  weight      Int        @default(50) // Traffic weight percentage
  pageViews   PageView[]
  events      Event[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([pageId, name])
}

model PageView {
  id          String       @id @default(cuid())
  pageId      String
  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     PageVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sessionId   String
  referrer    String?
  userAgent   String?
  pathname    String?
  createdAt   DateTime     @default(now())

  @@index([pageId, createdAt])
  @@index([sessionId])
  @@index([variantId])
}

model Event {
  id          String       @id @default(cuid())
  pageId      String
  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     PageVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sessionId   String
  eventType   String       // page_view, click, scroll, form_start, form_submit, cta_click, signup
  eventData   Json         @default("{}")
  createdAt   DateTime     @default(now())

  @@index([pageId, eventType, createdAt])
  @@index([sessionId])
  @@index([variantId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String?
  message   String?
  source    String?  // Which CTA/form captured this
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
  @@index([email])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  content   String
  rating    Int      @default(5)
  avatar    String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  price       Int      // in cents, 0 for free
  priceAnnual Int      // in cents
  description String
  features    Json     @default("[]")
  highlighted Boolean  @default(false)
  ctaText     String   @default("Get Started")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsAggregate {
  id              String   @id @default(cuid())
  pageId          String
  variantId       String?
  date            DateTime @db.Date
  pageViews        Int      @default(0)
  uniqueVisitors   Int      @default(0)
  formSubmissions  Int      @default(0)
  ctaClicks        Int      @default(0)
  avgTimeOnPage    Float    @default(0)
  bounceRate       Float    @default(0)
  conversionRate   Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([pageId, variantId, date])
  @@index([pageId, date])
}
